# ==============================================================================
# Neuro Focus Application — Environment Configuration Blueprint
# ==============================================================================
# Copy this file to .env and populate with your actual values.
# NEVER commit a populated .env file to version control.
# Add .env to .gitignore (already included in this project's .gitignore).
# ==============================================================================

# ── Android → Spring Boot API Connection ──────────────────────────────────────
# Base URL for the Spring Boot REST API.
# Use 10.0.2.2 when running the app in an Android Emulator against localhost.
# Replace with your LAN IP (e.g., 192.168.1.100) for physical device testing.
NEURO_API_BASE_URL=http://10.0.2.2:8080/api/

# Short timeouts ensure offline-first fallback activates quickly.
NEURO_API_CONNECT_TIMEOUT_SECONDS=2
NEURO_API_READ_TIMEOUT_SECONDS=2

# ── Presage SmartSpectra SDK Configuration ─────────────────────────────────────
# Obtain your API key from https://www.presagetech.com/
# For production builds, inject this via Android BuildConfig fields
# rather than hardcoding it in source files (see SmartSpectraManager.kt).
PRESAGE_SMARTSPECTRA_API_KEY=your_presage_api_key_here

# SDK log verbosity. Set to INFO or WARN for production builds.
PRESAGE_SDK_LOG_LEVEL=DEBUG

# ── Android Feature Flags ──────────────────────────────────────────────────────
# Enable Google Health Connect bidirectional sync (HR, HRV data).
FEATURE_FLAG_HEALTH_CONNECT_SYNC=true

# Enable WCAG AAA Outdoor Ultra-Contrast accessibility mode.
FEATURE_FLAG_OUTDOOR_CONTRAST=false

# Enable AI-generated session summary (future feature — currently no AI calls are made).
FEATURE_FLAG_AI_ASSISTANT=true

# Use PresageSpectraManager as a mock/fallback when the Presage SDK is unavailable.
FEATURE_FLAG_MOCK_FALLBACK_SENSING=true

# ── Telemetry & Logging ────────────────────────────────────────────────────────
# Android Scoped Storage directory for CSV telemetry exports.
TELEMETRY_EXPORT_DIR=Download

# Logcat filter tag for Presage SDK signal debugging.
LOGCAT_FILTER_TAG=PresageSmartSpectra
